# Copy to .env and fill in locally. Never commit .env or proxy credentials.

# --- Cloud VM --------------------------------------------------------------
# azure | gcp
CLOUD_PROVIDER=azure
VM_NAME=vless-3xui
# Linux admin account created on the VM
ADMIN_USER=debian

# Azure
AZURE_RESOURCE_GROUP=vless-3xui-rg
AZURE_LOCATION=uksouth
AZURE_VM_SIZE=Standard_B2s
# Override if the Debian 12 URN changes
# AZURE_IMAGE=Debian:debian-12:12-gen2:latest

# GCP
GCP_PROJECT=
GCP_ZONE=europe-west2-a
GCP_MACHINE_TYPE=e2-small
# GCP_NETWORK=default

# SSH public key used when creating the VM (defaults to ~/.ssh/id_ed25519.pub
# or ~/.ssh/id_rsa.pub).
# SSH_PUBLIC_KEY_FILE=

# --- 3x-ui -----------------------------------------------------------------
# Official release tag passed to install.sh. Change only after reading the
# release notes — newer Xray builds can enable post-quantum Reality features
# that many clients still cannot handshake.
XUI_VERSION=v3.11.0

# Optional pins. If unset, the official installer generates a random
# username, password, panel port, and web base path, and writes them to
# /etc/x-ui/install-result.env (mode 600) on the VM.
# XUI_USERNAME=
# XUI_PASSWORD=
# XUI_PANEL_PORT=2053
# XUI_WEB_BASE_PATH=

# How the operator talks to the panel API after install.
# Prefer an SSH tunnel and leave the panel closed to the internet:
#   ssh -N -L 2053:127.0.0.1:<panel-port> <admin>@<vm-ip>
# PANEL_BASE_URL=http://127.0.0.1:2053/<web-base-path>
# XUI_API_TOKEN=
# XUI_USERNAME=
# XUI_PASSWORD=

# --- Inbound ---------------------------------------------------------------
VLESS_PORT=443
REALITY_DEST=www.microsoft.com:443
REALITY_SNI=www.microsoft.com

# Public IPv4 of the VM, used in the vless:// link. Auto-detected when the
# scripts run on the VM.
# PUBLIC_IP=

# --- Optional UK static ISP SOCKS5 proxy ----------------------------------
# Leave blank to egress from the VM's own (datacentre) IP.
# The agent must never buy this for you. See references/human-proxy-step.md.
# PROXY_HOST=
# PROXY_PORT=12324
# PROXY_USER=
# PROXY_PASS=
PROXY_TAG=iproyal
