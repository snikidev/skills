# vless-vpn-3xui-ops configuration.
# Copy to ~/.config/vless-ops/.env and `chmod 600` it (the scripts warn otherwise),
# or point VLESS_OPS_ENV at another path. Process environment overrides this file.
# Never commit the filled-in copy. Values marked SECRET are never printed by the
# scripts: action cards show only the NAME and where it was read from.

# --- SSH to the VPS --------------------------------------------------------
# user@host or a Host alias from ~/.ssh/config (preferred: key, port, user live there)
VPS_SSH=debian@203.0.113.10
# optional explicit private key path (the key itself is never read by the scripts)
VPS_SSH_KEY=

# --- Panel API over the SSH tunnel -----------------------------------------
# panel port ON THE VPS          (= XUI_PANEL_PORT in /etc/x-ui/install-result.env)
PANEL_REMOTE_PORT=
# local end of the tunnel        (setup skill's ssh-tunnel-panel.sh uses 2053 too)
PANEL_LOCAL_PORT=2053
# web base path                  (= XUI_WEB_BASE_PATH in install-result.env, no slashes needed)
PANEL_BASE_PATH=
# optional: full URL instead of the three above (must still point at 127.0.0.1)
PANEL_BASE_URL=

# --- Panel credentials (pick one; token preferred) ---------------------------
# SECRET. admin-scope API token: Settings -> Security -> API Token, or XUI_API_TOKEN
# in install-result.env on the VPS. Used for every write and most reads.
XUI_API_TOKEN=
# SECRET, optional. monitor-scope token: used for `status` reads so day-to-day
# health checks don't carry admin rights.
XUI_MONITOR_TOKEN=
# Fallback cookie login (CSRF handled by the client). XUI_PASSWORD is SECRET.
XUI_USERNAME=
XUI_PASSWORD=

# --- Server facts -----------------------------------------------------------
# public IP or DNS name clients connect to (goes into vless:// links). Never 127.0.0.1.
PUBLIC_HOST=203.0.113.10
# inbound id; leave empty if there is exactly one VLESS Reality inbound
INBOUND_ID=
# tag of the optional SOCKS exit outbound added by the setup skill
PROXY_TAG=iproyal
# pinned 3x-ui release this server should run
XUI_VERSION=v3.11.0

# --- Local paths --------------------------------------------------------------
# panel DB backups (contain every user UUID and the Reality private key: keep private)
BACKUP_DIR=~/vless-ops-backups
# snapshots before writes, regenerated links, tunnel control socket
OPS_STATE_DIR=~/.local/state/vless-ops

# --- Cloud (optional; same names as the setup skill's .env) ---------------------
# azure | gcp. Empty = no cloud ops (and no cloud snapshot before upgrades).
CLOUD_PROVIDER=
VM_NAME=vless-3xui
# Azure: expected subscription NAME or id (preflight refuses if `az account` differs)
AZURE_SUBSCRIPTION=
AZURE_RESOURCE_GROUP=vless-3xui-rg
# optional; auto-detected from the VM's NIC
AZURE_NSG_NAME=
# GCP: project id (every gcloud call passes --project explicitly)
GCP_PROJECT=
GCP_ZONE=europe-west2-a
GCP_NETWORK=default
GCP_NETWORK_TAG=vless-3xui

# --- Drift expectations ------------------------------------------------------------
# 1 = the proxy outbound must exist and be FIRST (default for every new connection)
EXPECT_PROXY=1
# comma-separated MATCHER->OUTBOUND rules that must be present
EXPECT_RULES=geoip:private->direct,domain:openrouter.ai->direct
